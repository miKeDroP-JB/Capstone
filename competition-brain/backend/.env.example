# OpenAI API Key (for GPT models and o1)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini API Key (for Gemini models)
GOOGLE_API_KEY=your-google-api-key-here

# Mistral API Key (for Mistral models)
MISTRAL_API_KEY=your-mistral-api-key-here

# Cohere API Key (for Command R7B)
COHERE_API_KEY=your-cohere-api-key-here

# Groq API Key (for fast Llama inference)
GROQ_API_KEY=your-groq-api-key-here

# DeepSeek API Key (for DeepSeek V3)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# xAI API Key (for Grok 2)
XAI_API_KEY=your-xai-api-key-here

# Perplexity API Key (for web-grounded responses)
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Server Port
PORT=3001

# Environment
NODE_ENV=development
