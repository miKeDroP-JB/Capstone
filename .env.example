# SALES MACHINE - Environment Variables
# =======================================
# Copy this file to .env and fill in your values
#
# Love - Loyalty - Honor - Everybody Eats

# ===========================================
# REQUIRED - Twilio (for making/receiving calls)
# ===========================================
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# OPTIONAL - Voice Synthesis (pick one)
# ===========================================
# ElevenLabs - Best quality (recommended)
# Get key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# OpenAI TTS - Good quality, reliable
# Get key from https://platform.openai.com
OPENAI_API_KEY=your_openai_key_here

# PlayHT - Alternative option
# Get key from https://play.ht
PLAYHT_API_KEY=your_playht_key_here

# ===========================================
# OPTIONAL - Speech Recognition (pick one)
# ===========================================
# Deepgram - Best real-time STT (recommended)
# Get key from https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_key_here

# Whisper uses OpenAI API key above

# ===========================================
# OPTIONAL - Research & Scraping
# ===========================================
# SerpAPI - For Google search results
# Get key from https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# ===========================================
# OPTIONAL - CRM & Notifications
# ===========================================
# Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ===========================================
# CAMPAIGN SETTINGS
# ===========================================
# Default industry
DEFAULT_INDUSTRY=hvac

# Calls per hour limit
CALLS_PER_HOUR=30

# Commission rate (0.10 = 10%)
COMMISSION_RATE=0.10
